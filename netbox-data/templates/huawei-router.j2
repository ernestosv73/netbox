sysname {{ device.name }}

{% for intf in device.interfaces.all() %}
{% if intf.enabled %}
interface {{ intf.name }}
{% if intf.description %}
 description {{ intf.description }}
{% endif %}

{% for ip in intf.assigned_ips %}
{% if ip.family.value == 4 %}
 ip address {{ ip.address }}
{% elif ip.family.value == 6 %}
 ipv6 address {{ ip.address }}
{% endif %}
{% endfor %}

 quit
{% endif %}
{% endfor %}
