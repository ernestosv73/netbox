config system interface
    edit "{{ intf.name }}"
        set vdom "{{ intf.custom_fields.fortigate_vdom | default('root') }}"
        set type {{ intf.custom_fields.fortigate_type | default('physical') }}
        {% if intf.custom_fields.fortigate_alias %}
        set alias "{{ intf.custom_fields.fortigate_alias }}"
        {% endif %}
        set device-identification enable
        set lldp-transmission enable
        {% if intf.custom_fields.fortigate_role %}
        set role {{ intf.custom_fields.fortigate_role }}
        {% endif %}

        {# --- IPv4 --- #}
        {% for ip in intf.ip_addresses.all() | selectattr('family.value', '==', 4) %}
        set ip {{ ip.address.ip }} {{ ip.address.netmask }}
        {% endfor %}

        {# --- IPv6 --- #}
        {% for ip in intf.ip_addresses.all() | selectattr('family.value', '==', 6) %}
        config ipv6
            set ip6-address {{ ip.address }}
            {% if intf.custom_fields.ip6_allowaccess %}
            set ip6-allowaccess {{ intf.custom_fields.ip6_allowaccess }}
            {% else %}
            set ip6-allowaccess ping
            {% endif %}
        end
        {% endfor %}
    next
end
